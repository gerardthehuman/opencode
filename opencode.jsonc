{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "default_agent": "lead",
  "instructions": ["~/.agents/AGENTS.md"],
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "websearch": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa&exaApiKey={env:EXA_API_KEY}"
    }
  },
  "permission": {
    "external_directory": {
      "*": "allow",
      "/**": "allow",
      "/tmp/**": "allow",
      "/var/**": "allow",
      "~/.agents/**": "allow"
    },
    "question": "allow"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter",
    "@gblab/opencode-dcp",
    "opencode-pty",
    [
      "@plannotator/opencode@0.26.2",
      {
        "planningAgents": ["plan"],
        "workflow": "all-agents"
      }
    ],
    [
      "./plugins/claude-code/src/index.ts",
      {
        "pricing": "enterprise"
      }
    ],
    [
      "./plugins/forge/plugins/opencode.ts",
      {
        "agent": {
          "chat": {
            "model": "forge/openai/gpt-5.6-luna",
            "variant": "medium"
          },
          "lens": {
            "disable": true
          },
          "plan": {
            "disable": true
          }
        },
        "model": "forge/openai/gpt-5.6-terra",
        "small_model": "forge/x-ai/grok-build-0.1"
      }
    ]
  ],
  "provider": {
    "claude-code": {
      "whitelist": ["claude-opus-5", "claude-sonnet-5"]
    },
    "github-copilot": {
      "whitelist": ["claude-haiku-4.5", "claude-sonnet-4.5", "gpt-5.3-codex"]
    },
    "opencode": {
      "whitelist": ["deepseek-v4-flash-free", "mimo-v2.5-free", "minimax-m3-free"]
    }
  },
  "skills": {
    "paths": ["~/.codex/skills"]
  }
}
