{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "default_agent": "lead",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "websearch": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa&exaApiKey={env:EXA_API_KEY}"
    }
  },
  "permission": {
    "external_directory": {
      "*": "allow",
      "/**": "allow"
    },
    "question": "allow"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter",
    "@khalilgharbaoui/opencode-claude-code-plugin",
    "@tarquinen/opencode-dcp",
    "opencode-pty",
    [
      "@plannotator/opencode@0.25.1",
      {
        "planningAgents": [
          "plan"
        ],
        "workflow": "all-agents"
      }
    ],
    [
      "./plugins/forge/plugins/opencode.ts",
      {
        "agent": {
          "chat": {
            "model": "forge/openai/gpt-5.6-luna",
            "variant": "medium"
          },
          "code": {
            "model": "forge/openai/gpt-5.6-terra",
            "variant": "xhigh"
          },
          "explore": {
            "model": "forge/openai/gpt-5.6-luna",
            "variant": "medium"
          },
          "lead": {
            "model": "forge/openai/gpt-5.6-sol",
            "variant": "xhigh"
          },
          "plan": {
            "disable": true,
            "model": "forge/openai/gpt-5.6-terra",
            "variant": "xhigh"
          },
          "research": {
            "model": "forge/openai/gpt-5.6-terra",
            "variant": "high"
          },
          "review": {
            "model": "forge/x-ai/grok-4.5",
            "variant": "high"
          }
        },
        "model": "forge/openai/gpt-5.6-terra",
        "small_model": "forge/openai/gpt-5.6-luna"
      }
    ]
  ],
  "provider": {},
  "skills": {
    "paths": [
      "~/.codex/skills"
    ]
  }
}